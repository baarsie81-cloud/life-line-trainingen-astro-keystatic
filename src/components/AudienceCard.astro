---
interface Props {
  label: string;
  title: string;
  text: string;
  linkLabel: string;
  href: string;
}

const { label, title, text, linkLabel, href } = Astro.props;
---

<a class="audience-card" href={href}>
  <span>{label}</span>
  <strong>{title}</strong>
  <p>{text}</p>
  <em>{linkLabel}</em>
</a>
