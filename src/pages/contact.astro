---
import BaseLayout from "../layouts/BaseLayout.astro";
import page from "../content/pages/contact.json";

const formEndpoint = "https://formspree.io/f/mkjgzvqz";
---

<BaseLayout title={page.seoTitle} description={page.seoDescription} image={page.hero.image}>
  <section class="page-hero contact-hero">
    <img class="page-hero-image" src={page.hero.image} alt={page.hero.imageAlt} loading="eager" decoding="async" />
    <div class="page-hero-overlay"></div>
    <div class="container page-hero-content">
      <div class="page-hero-copy">
        <p class="eyebrow">{page.hero.eyebrow}</p>
        <h1>{page.hero.title}</h1>
        <p class="hero-intro">{page.hero.intro}</p>
      </div>
      <aside class="hero-proof" aria-label="Contact met Life-Line-Trainingen">
        <span>{page.hero.proofLabel}</span>
        <p>{page.hero.proofText}</p>
      </aside>
    </div>
  </section>

  <section class="section contact-section" aria-labelledby="contact-form-title">
    <div class="container contact-grid">
      <form class="contact-form" id="contact-form" action={formEndpoint} method="POST">
        <div class="form-heading">
          <p class="eyebrow">{page.form.eyebrow}</p>
          <h2 id="contact-form-title">{page.form.title}</h2>
          <p>{page.form.intro}</p>
        </div>

        <div class="form-row">
          <label>
            <span>{page.form.labels.firstName}</span>
            <input name="voornaam" autocomplete="given-name" required />
          </label>
          <label>
            <span>{page.form.labels.lastName}</span>
            <input name="achternaam" autocomplete="family-name" />
          </label>
        </div>

        <div class="form-row">
          <label>
            <span>{page.form.labels.email}</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label>
            <span>{page.form.labels.phone}</span>
            <input name="telefoon" type="tel" autocomplete="tel" required />
          </label>
        </div>

        <label>
          <span>{page.form.labels.company}</span>
          <input name="bedrijfsnaam" autocomplete="organization" />
        </label>

        <label>
          <span>{page.form.labels.message}</span>
          <textarea name="bericht" rows="7" required></textarea>
        </label>

        <p class="privacy-copy">
          {page.form.privacyText}
          {" "}
          <a href="/juridisch/privacy-statement/">{page.form.labels.privacyLink}</a>.
        </p>

        <div class="form-actions">
          <button class="button button-primary" type="submit">{page.form.submitLabel}</button>
          <a class="mail-fallback" href={`mailto:${page.contactCard.email}`}>{page.form.fallbackLabel}</a>
        </div>
        <p class="form-status" id="contact-form-status" role="status" aria-live="polite" aria-atomic="true"></p>
      </form>

      <aside class="contact-card" aria-label={page.contactCard.title}>
        <img src={page.contactCard.image} alt={page.contactCard.imageAlt} loading="lazy" decoding="async" />
        <div class="contact-card-body">
          <p class="eyebrow">{page.contactCard.eyebrow}</p>
          <h2>{page.contactCard.title}</h2>
          <dl>
            <div>
              <dt>{page.contactCard.emailLabel}</dt>
              <dd><a href={`mailto:${page.contactCard.email}`}>{page.contactCard.email}</a></dd>
            </div>
            <div>
              <dt>{page.contactCard.addressLabel}</dt>
              <dd>
                {page.contactCard.address.map((line) => <span>{line}</span>)}
              </dd>
            </div>
          </dl>
          <p>{page.contactCard.responsePromise}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-soft contact-reasons" aria-labelledby="contact-reasons-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{page.reasons.eyebrow}</p>
        <h2 id="contact-reasons-title">{page.reasons.title}</h2>
      </div>
      <div class="contact-reason-grid">
        {
          page.reasons.items.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <script define:vars={{ sendingLabel: page.form.sendingLabel, successText: page.form.successText, errorText: page.form.errorText }}>
    const form = document.querySelector("#contact-form");
    const status = document.querySelector("#contact-form-status");
    const submitButton = form?.querySelector('button[type="submit"]');
    const submitLabel = submitButton?.textContent;

    form?.addEventListener("input", () => {
      status.textContent = "";
      delete status.dataset.state;
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (form.getAttribute("aria-busy") === "true") return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      status.textContent = "";
      delete status.dataset.state;
      submitButton.disabled = true;
      submitButton.textContent = sendingLabel;
      form.setAttribute("aria-busy", "true");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (!response.ok) throw new Error("Formspree rejected the submission");

        form.reset();
        status.textContent = successText;
        status.dataset.state = "success";
      } catch {
        status.textContent = errorText;
        status.dataset.state = "error";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = submitLabel;
        form.removeAttribute("aria-busy");
      }
    });
  </script>
</BaseLayout>
