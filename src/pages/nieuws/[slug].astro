---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Markdoc from "@markdoc/markdoc";
import knowledge from "../../content/pages/knowledge.json";
import site from "../../content/settings/site.json";
import { withContentSlugs } from "../../lib/content";

export const prerender = true;

const blogFiles = import.meta.glob("../../content/blogs/*.json", { eager: true });
const allBlogs = withContentSlugs(blogFiles);
const visibleBlogs = allBlogs
  .filter((blog) => blog.visible)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

export function getStaticPaths() {
  const files = import.meta.glob("../../content/blogs/*.json", { eager: true });
  const blogs = withContentSlugs(files)
    .filter((blog) => blog.visible);

  return blogs.map((blog) => ({
    params: { slug: blog.slug },
    props: { blog },
  }));
}

const { blog } = Astro.props;
const seoTitle = blog.seoTitle || `${blog.title} | Life-Line-Trainingen`;
const seoDescription = blog.seoDescription || blog.excerpt;
const related = visibleBlogs
  .filter((item) => item.slug !== blog.slug && item.category === blog.category)
  .slice(0, 3);

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("nl-NL", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(date));

const canonical = new URL(`/nieuws/${blog.slug}/`, site.url);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: blog.title,
  description: seoDescription,
  image: new URL(blog.image, site.url).href,
  datePublished: blog.date,
  dateModified: blog.date,
  author: {
    "@type": "Person",
    name: blog.author,
  },
  publisher: {
    "@type": "Organization",
    name: site.name,
    url: site.url,
    logo: {
      "@type": "ImageObject",
      url: new URL(site.logos.blue, site.url).href,
    },
  },
  mainEntityOfPage: canonical.href,
};
const articleHtml = Markdoc.renderers
  .html(Markdoc.transform(Markdoc.parse(blog.bodyMarkdown)))
  .replace(/<a href="(https?:\/\/[^\"]+)"/g, '<a href="$1" target="_blank" rel="noopener noreferrer"');
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={blog.image}
  type="article"
  structuredData={structuredData}
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-inner">
        <a class="back-link" href="/nieuws/">{knowledge.article.backLabel}</a>
        <div class="article-meta">
          <span>{formatDate(blog.date)}</span>
          <span>{blog.category}</span>
          <span>{blog.readingTime}</span>
        </div>
        <h1>{blog.title}</h1>
        <p>{blog.excerpt}</p>
      </div>
    </header>

    <div class="container article-layout">
      <aside class="article-sidebar" aria-label="Artikelinformatie">
        <img src={blog.image} alt={blog.imageAlt} loading="eager" decoding="async" />
        <dl>
          <div>
            <dt>{knowledge.article.authorLabel}</dt>
            <dd>{blog.author}</dd>
          </div>
          <div>
            <dt>{knowledge.article.audienceLabel}</dt>
            <dd>{blog.audience}</dd>
          </div>
        </dl>
      </aside>

      <div class="article-content" set:html={articleHtml} />
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section-soft related-articles" aria-labelledby="related-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">{knowledge.article.relatedEyebrow}</p>
          <h2 id="related-title">{knowledge.article.relatedTitlePrefix} {blog.category.toLowerCase()}</h2>
        </div>
        <div class="related-grid">
          {
            related.map((item) => (
              <article class="related-card">
                <img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" />
                <div>
                  <span>{formatDate(item.date)}</span>
                  <h3>
                    <a href={`/nieuws/${item.slug}/`}>{item.title}</a>
                  </h3>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  )}

  <section class="final-cta">
    <div class="container final-cta-inner">
      <div>
        <p class="eyebrow">{knowledge.articleCta.eyebrow}</p>
        <h2>{knowledge.articleCta.title}</h2>
        <p>{knowledge.articleCta.text}</p>
      </div>
      <a class="button button-light" href={knowledge.articleCta.button.href}>{knowledge.articleCta.button.label}</a>
    </div>
  </section>
</BaseLayout>
