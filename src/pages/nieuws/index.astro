---
import BaseLayout from "../../layouts/BaseLayout.astro";
import knowledge from "../../content/pages/knowledge.json";
import { withContentSlugs } from "../../lib/content";

const blogFiles = import.meta.glob("../../content/blogs/*.json", { eager: true });
const blogs = withContentSlugs(blogFiles)
  .filter((blog) => blog.visible)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const featured = blogs[0];
const articles = blogs.filter((blog) => blog !== featured);
const categories = Array.from(new Set(blogs.map((blog) => blog.category))).sort();

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("nl-NL", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(date));
---

<BaseLayout
  title={knowledge.seoTitle}
  description={knowledge.seoDescription}
  image={featured?.image}
>
  <section class="knowledge-hero">
    <div class="container knowledge-hero-inner">
      <div>
        <p class="eyebrow">{knowledge.hero.eyebrow}</p>
        <h1>{knowledge.hero.title}</h1>
        <p>{knowledge.hero.intro}</p>
      </div>
    </div>
  </section>

  {featured && (
    <section class="section knowledge-featured" aria-labelledby="featured-article-title">
      <div class="container featured-article">
        <a class="featured-media" href={`/nieuws/${featured.slug}/`} aria-label={featured.title}>
          <img src={featured.image} alt={featured.imageAlt} loading="eager" decoding="async" />
        </a>
        <div class="featured-copy">
          <p class="eyebrow">{knowledge.featured.eyebrow}</p>
          <h2 id="featured-article-title">
            <a href={`/nieuws/${featured.slug}/`}>{featured.title}</a>
          </h2>
          <p>{featured.excerpt}</p>
          <div class="article-meta">
            <span>{formatDate(featured.date)}</span>
            <span>{featured.category}</span>
            <span>{featured.readingTime}</span>
          </div>
          <a class="button button-primary" href={`/nieuws/${featured.slug}/`}>{knowledge.featured.buttonLabel}</a>
        </div>
      </div>
    </section>
  )}

  <section class="section section-soft knowledge-index" id="articles">
    <div class="container">
      <div class="knowledge-toolbar">
        <div>
          <p class="eyebrow">{knowledge.index.eyebrow}</p>
          <h2>{knowledge.index.title}</h2>
        </div>
        <div class="filter-buttons" aria-label={knowledge.index.filterLabel}>
          <button type="button" class="is-active" data-filter="all">{knowledge.index.allLabel}</button>
          {categories.map((category) => <button type="button" data-filter={category}>{category}</button>)}
        </div>
      </div>

      <div class="article-grid">
        {
          articles.map((article) => (
            <article class="article-card" data-category={article.category}>
              <a class="article-card-media" href={`/nieuws/${article.slug}/`} aria-label={article.title}>
                <img src={article.image} alt={article.imageAlt} loading="lazy" decoding="async" />
              </a>
              <div class="article-card-copy">
                <div class="article-meta">
                  <span>{formatDate(article.date)}</span>
                  <span>{article.category}</span>
                </div>
                <h3>
                  <a href={`/nieuws/${article.slug}/`}>{article.title}</a>
                </h3>
                <p>{article.excerpt}</p>
                <a class="article-link" href={`/nieuws/${article.slug}/`}>{knowledge.index.articleLinkLabel}</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container final-cta-inner">
      <div>
        <p class="eyebrow">{knowledge.indexCta.eyebrow}</p>
        <h2>{knowledge.indexCta.title}</h2>
        <p>{knowledge.indexCta.text}</p>
      </div>
      <a class="button button-light" href={knowledge.indexCta.button.href}>{knowledge.indexCta.button.label}</a>
    </div>
  </section>

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>("[data-category]");

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter || "all";
        filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
        cards.forEach((card) => {
          card.hidden = filter !== "all" && card.dataset.category !== filter;
        });
      });
    });
  </script>
</BaseLayout>
